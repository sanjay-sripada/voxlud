# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Local development ---
# Copy to .env.local
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Production ---
# Copy to .env.production.local (local prod builds)
# and add the same vars in Vercel → Settings → Environment Variables
# NEXT_PUBLIC_SITE_URL=https://voxlud.vercel.app

# LLM — AI designs game config from chat (required for /create)
# Pick ONE provider block below (only one LLM_PROVIDER line).
# LLM_ALLOW_PARSER_FALLBACK=true   # optional: allow keyword parser when AI fails
# LLM_MODELS=model-a,model-b   # optional comma-separated override list for the dropdown

# OpenAI (default)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Groq — free tier: https://console.groq.com
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...

# Hugging Face — free tier: https://huggingface.co/settings/tokens
# LLM_PROVIDER=huggingface
# HUGGINGFACE_API_KEY=hf_...

# Ollama — local, free (run: ollama pull llama3.2)
# LLM_PROVIDER=ollama

# OpenRouter — includes free models
# LLM_PROVIDER=openrouter
# OPENAI_API_KEY=sk-or-...


